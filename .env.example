# TTS provider.
TTS_PROVIDER=volcengine
VOLCENGINE_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
VOLCENGINE_TTS_API_KEY=
VOLCENGINE_TTS_RESOURCE_ID=volc.service_type.10029
VOLCENGINE_TTS_VOICE_TYPE=en_female_nadia_tips_emo_v2_mars_bigtts
VOLCENGINE_TTS_FORMAT=mp3
VOLCENGINE_TTS_SAMPLE_RATE=24000
CALLER_TTS_RESOURCE_ID=seed-tts-2.0
CALLER_TTS_VOICE_TYPE=zh_male_wennuanahu_uranus_bigtts
KOKORO_API_BASE=http://127.0.0.1:8880
KOKORO_MODEL=onnx-community/Kokoro-82M-v1.0-ONNX
KOKORO_VOICE=af_heart
KOKORO_RESPONSE_FORMAT=wav
CALLER_TTS_PROVIDER=
TTS_SYNTH_RETRIES=2
TTS_SYNTH_CONCURRENCY=3

# Music provider.
MUSIC_PROVIDER=auto
MUSIC_FALLBACK_PROVIDER=yt-dlp
MUSIC_RESOLVE_CONCURRENCY=3
DIRECT_ARTIST_TRACK_COUNT=3
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/auth/spotify/callback
SPOTIFY_MARKET=US
SPOTIFY_ALLOW_PREVIEW=0
SPOTIFY_FAST_START=0
NETEASE_AUTO_START=0
NETEASE_LOGIN_BOOTSTRAP=0
NETEASE_API_BASE=http://127.0.0.1:3000
NETEASE_LEVEL=standard
NETEASE_COOKIE=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# LLM provider.
LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDERS=claude_cli
LLM_RETRIES=2
LLM_RETRY_DELAY_MS=1200

# Gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash
